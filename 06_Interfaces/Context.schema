{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Context Interface Contract",
  "description": "Defines the canonical structure for the unified market context exchanged between AITOS modules.",
  "type": "object",
  "version": "1.0.0",
  "compatibility": "backward-compatible",
  "error_behavior": "reject-on-validation-failure",
  "properties": {
    "context_id": {
      "type": "string",
      "description": "Unique identifier for the market context snapshot."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the context was generated."
    },
    "instrument_id": {
      "type": "string",
      "description": "Trading instrument for which the context is generated."
    },
    "market_structure": {
      "$ref": "#/definitions/MarketStructure",
      "description": "Current market structure assessment."
    },
    "liquidity_zones": {
      "type": "array",
      "items": { "$ref": "#/definitions/LiquidityZone" },
      "description": "Identified liquidity zones."
    },
    "order_blocks": {
      "type": "array",
      "items": { "$ref": "#/definitions/OrderBlock" },
      "description": "Identified order blocks."
    },
    "fair_value_gaps": {
      "type": "array",
      "items": { "$ref": "#/definitions/FairValueGap" },
      "description": "Identified fair value gaps."
    },
    "efficiency_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Market efficiency score (0 to 1)."
    },
    "regime": {
      "type": "string",
      "description": "Current market regime (e.g., trending, ranging, volatile)."
    },
    "metadata": {
      "type": "object",
      "description": "Optional additional metadata related to the context.",
      "additionalProperties": true
    }
  },
  "required": ["context_id", "timestamp", "instrument_id", "market_structure", "efficiency_score", "regime"],
  "definitions": {
    "MarketStructure": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["BOS", "CHoCH", "Range", "Trend"] },
        "direction": { "type": "string", "enum": ["Bullish", "Bearish", "Neutral"] },
        "confirmation_level": { "type": "number", "minimum": 0 }
      },
      "required": ["type", "direction"]
    },
    "LiquidityZone": {
      "type": "object",
      "properties": {
        "start_price": { "type": "number" },
        "end_price": { "type": "number" },
        "type": { "type": "string", "enum": ["BuySide", "SellSide"] },
        "strength": { "type": "number", "minimum": 0 }
      },
      "required": ["start_price", "end_price", "type"]
    },
    "OrderBlock": {
      "type": "object",
      "properties": {
        "start_price": { "type": "number" },
        "end_price": { "type": "number" },
        "type": { "type": "string", "enum": ["Bullish", "Bearish"] },
        "volume_profile": { "type": "number", "minimum": 0 }
      },
      "required": ["start_price", "end_price", "type"]
    },
    "FairValueGap": {
      "type": "object",
      "properties": {
        "start_price": { "type": "number" },
        "end_price": { "type": "number" },
        "type": { "type": "string", "enum": ["BullishImbalance", "BearishImbalance"] }
      },
      "required": ["start_price", "end_price", "type"]
    }
  }
}
