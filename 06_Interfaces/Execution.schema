{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Execution Interface Contract",
  "description": "Defines the canonical structure for trade execution events and entities exchanged between AITOS modules.",
  "type": "object",
  "version": "1.0.0",
  "compatibility": "backward-compatible",
  "error_behavior": "reject-on-validation-failure",
  "properties": {
    "execution_id": {
      "type": "string",
      "description": "Unique identifier for the execution event."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the execution event occurred."
    },
    "trade_id": {
      "type": "string",
      "description": "Reference to the associated Trade entity."
    },
    "order_id": {
      "type": "string",
      "description": "Reference to the associated Order entity."
    },
    "instrument_id": {
      "type": "string",
      "description": "Unique identifier for the trading instrument."
    },
    "action": {
      "type": "string",
      "enum": ["BUY", "SELL"],
      "description": "Action of the execution."
    },
    "quantity": {
      "type": "number",
      "minimum": 0,
      "description": "Executed quantity."
    },
    "price": {
      "type": "number",
      "minimum": 0,
      "description": "Executed price."
    },
    "status": {
      "type": "string",
      "enum": ["FILLED", "PARTIAL_FILL", "REJECTED", "CANCELED"],
      "description": "Status of the execution."
    },
    "venue": {
      "type": "string",
      "description": "Exchange or venue where the order was executed."
    },
    "metadata": {
      "type": "object",
      "description": "Optional additional metadata related to the execution.",
      "additionalProperties": true
    }
  },
  "required": ["execution_id", "timestamp", "trade_id", "order_id", "instrument_id", "action", "quantity", "price", "status", "venue"]
}
