{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aitos.io/schemas/v2/OHLCVBar.schema.json",
  "title": "OHLCVBar",
  "description": "Schema for the canonical OHLCV bar stream ingested by AITOS modules.",
  "type": "object",
  "required": ["time", "open", "high", "low", "close", "volume", "timeframe"],
  "properties": {
    "time": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the bar closing time."
    },
    "open": {
      "type": "number",
      "description": "Opening price of the bar."
    },
    "high": {
      "type": "number",
      "description": "Highest price reached during the bar."
    },
    "low": {
      "type": "number",
      "description": "Lowest price reached during the bar."
    },
    "close": {
      "type": "number",
      "description": "Closing price of the bar."
    },
    "volume": {
      "type": "number",
      "minimum": 0,
      "description": "Total trading volume during the bar."
    },
    "timeframe": {
      "type": "string",
      "enum": ["M15", "H1", "H4", "D", "W", "M"],
      "description": "The timeframe interval of the bar."
    }
  },
  "additionalProperties": false
}
