{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aitos.io/schemas/v2/SessionLiquidity.schema.json",
  "title": "SessionLiquidity",
  "description": "Schema for session-based liquidity scores emitted by SESSION-10.",
  "type": "object",
  "required": ["instrument_id", "session_liquidity_score", "is_fallback"],
  "properties": {
    "instrument_id": {
      "type": "string",
      "description": "Unique identifier for the trading instrument."
    },
    "session_liquidity_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Liquidity score from 0.0 (illiquid) to 1.0 (highly liquid)."
    },
    "is_fallback": {
      "type": "boolean",
      "description": "Flag indicating if the score is a fallback default (0.5) due to data unavailability."
    }
  },
  "additionalProperties": false
}
