{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Signal Interface Contract",
  "description": "Defines the canonical structure for trading signals generated by AITOS modules.",
  "type": "object",
  "version": "1.0.0",
  "compatibility": "backward-compatible",
  "error_behavior": "reject-on-validation-failure",
  "properties": {
    "signal_id": {
      "type": "string",
      "description": "Unique identifier for the trading signal."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the signal was generated."
    },
    "instrument": {
      "type": "string",
      "description": "Trading instrument for which the signal is generated (e.g., EURUSD, BTCUSD)."
    },
    "direction": {
      "type": "string",
      "enum": ["BUY", "SELL", "HOLD"],
      "description": "Direction of the proposed trade."
    },
    "entry_price": {
      "type": "number",
      "minimum": 0,
      "description": "Proposed entry price for the trade."
    },
    "stop_loss": {
      "type": "number",
      "minimum": 0,
      "description": "Proposed stop loss price."
    },
    "take_profit": {
      "type": "number",
      "minimum": 0,
      "description": "Proposed take profit price."
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence level of the signal (0 to 1)."
    },
    "source_module": {
      "type": "string",
      "description": "Module that generated the signal (e.g., AITOS-ALPHA, AITOS-SMC)."
    },
    "metadata": {
      "type": "object",
      "description": "Optional additional metadata related to the signal.",
      "additionalProperties": true
    }
  },
  "required": ["signal_id", "timestamp", "instrument", "direction", "entry_price", "confidence_score", "source_module"]
}
