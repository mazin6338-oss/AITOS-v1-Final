{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aitos.io/schemas/v2/StrategyBias.schema.json",
  "title": "StrategyBias",
  "description": "Schema for the strategy bias emitted by MSTRUCT to guide ALPHA and RISK modules.",
  "type": "object",
  "required": ["instrument_id", "timeframe", "allow_long", "allow_short", "prefer_mean_reversion", "entropy"],
  "properties": {
    "instrument_id": {
      "type": "string",
      "description": "Unique identifier for the trading instrument."
    },
    "timeframe": {
      "type": "string",
      "enum": ["M15", "H1", "H4", "D", "W", "M"],
      "description": "The timeframe of the analysis."
    },
    "allow_long": {
      "type": "boolean",
      "description": "Whether long positions are permitted based on market structure."
    },
    "allow_short": {
      "type": "boolean",
      "description": "Whether short positions are permitted based on market structure."
    },
    "prefer_mean_reversion": {
      "type": "boolean",
      "description": "Whether mean reversion strategies are preferred over trend following."
    },
    "entropy": {
      "type": "number",
      "description": "Uncertainty level from the underlying belief state."
    }
  },
  "additionalProperties": false
}
